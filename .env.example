# Copier en .env (non versionné) et renseigner.

# Utilisateur SSDV2 de l'hôte (id -u / id -g / getent group docker).
SSDV2_USER=utilisateur
SSDV2_UID=1000
SSDV2_GID=1000
DOCKER_GID=999

# Port local d'écoute (127.0.0.1 uniquement).
WEBUI_PORT=8800

# true derrière un reverse proxy HTTPS.
COOKIE_SECURE=false

# Compte admin créé au premier démarrage (sinon assistant /setup).
# WEBUI_ADMIN_USER=admin
# WEBUI_ADMIN_PASSWORD=

# Durée maximale d'un flux SSE avant reconnexion propre (secondes ; défaut 900).
# WEBUI_SSE_MAX_SECONDS=900

# Authentification (facultatif). Par défaut : mode « internal » (identifiant/mot de passe).
# Imposer le mode : internal ou proxy (une valeur invalide retombe sur internal).
# WEBUI_AUTH_MODE=
# Mode proxy : identité issue d'un en-tête unique transmis par un proxy de confiance.
# Renseigner au moins l'un des deux (sinon les accès protégés sont refusés, fail-closed) :
# WEBUI_TRUSTED_PROXIES=172.18.0.0/16
# WEBUI_TRUST_PROXY=false
# WEBUI_PROXY_IDENTITY_HEADER=X-Auth-Request-User
# Déconnexion du fournisseur externe (facultatif) :
# WEBUI_EXTERNAL_LOGOUT_URL=

# Pour tester un ssdv2ctl en cours de développement (décommenter aussi le
# montage correspondant dans compose.yaml).
# SSDV2CTL_DIR=/chemin/vers/ssdv2-ctl-dev
