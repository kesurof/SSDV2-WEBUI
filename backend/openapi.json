        "title": "AppAuthOut"
      },
      "AppDetailOut": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "description": {
            "type": "string",
            "title": "Description"
          },
          "available": {
            "type": "boolean",
            "title": "Available"
          },
          "installed": {
            "type": "boolean",
            "title": "Installed"
          },
          "runtime_status": {
            "type": "string",
            "enum": [
              "running",
              "partial",
              "stopped",
              "unknown",
              "not_installed"
            ],
            "title": "Runtime Status"
          },
          "healthy": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Healthy"
          },
          "url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Url"
          },
          "image": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Image"
          },
          "containers": {
            "type": "integer",
            "title": "Containers"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Warnings"
          },
          "container_list": {
            "items": {
              "$ref": "#/components/schemas/ContainerOut"
            },
            "type": "array",
            "title": "Container List"
          },
          "ssddb": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SsddbAppOut"
              },
              {
                "type": "null"
              }
            ]
